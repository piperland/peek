# The negative half of the inheritance gate: an edge whose subject is one of these
# is a false positive whatever it points at.
no_inherits | src/traits.rs | Clock | -
no_inherits | src/traits.rs | Pair | -
no_inherits | src/traits.rs | Store | -

# The supertrait and the four impl blocks all name traits this file declares, so
# each of the five edges has a referent in this file.
binds | inherits | src/traits.rs | trait | Saveable | Clock | src/traits.rs | trait | Clock
binds | implements | src/traits.rs | module | Ticks | Clock | src/traits.rs | trait | Clock
binds | implements | src/traits.rs | module | Ticks | Saveable | src/traits.rs | trait | Saveable
binds | implements | src/traits.rs | module | Meters | Clock | src/traits.rs | trait | Clock
binds | implements | src/traits.rs | module | Meters | Saveable | src/traits.rs | trait | Saveable

# `Saveable.save` has no body, so `entry` occurs in its signature only, as the
# parameter's binding. Under the negative rule below that is a declaration rather
# than a use, so this line is believed wrong. It is left in place deliberately: it is
# a miss rather than a violation, and the two `save` lines under it are the same
# construct with a body and are labelled references, which is the reading that makes
# the engine's miss here a finding about this line.
reference | src/traits.rs | Saveable.save | entry
reference | src/traits.rs | Ticks.save | entry
reference | src/traits.rs | Meters.save | entry
no_reference | src/traits.rs | Clock.now | now
no_reference | src/traits.rs | Saveable | Saveable

# `Ticks::save` and `Meters::save` have bodies; `entry` is read through `entry.count`
# in each, so it denotes the parameter and nothing else. `Saveable.save` has no
# body, so the line above it is believed wrong; the placement below is what the
# line would require if it existed at all.
binds | references | src/traits.rs | method | Saveable.save | entry | src/traits.rs | parameter | Saveable.save.entry
binds | references | src/traits.rs | method | Ticks.save | entry | src/traits.rs | parameter | Ticks.save.entry
binds | references | src/traits.rs | method | Meters.save | entry | src/traits.rs | parameter | Meters.save.entry

