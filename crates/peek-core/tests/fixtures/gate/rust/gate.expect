# ---------------------------------------------------------------------------
# Query correctness: questions the surface has to answer correctly.
#
# Each expectation names the target and the entity the answer must contain. A
# query that returns a superset still passes, because a walk is allowed to reach
# more than was asked for; a query that omits the named entity fails.
# ---------------------------------------------------------------------------
callers | src/service.rs | function | retry | src/service.rs | method | Runner.run
callers | src/report.rs | method | Sink.push | src/report.rs | function | render
callers | src/model.rs | function | entry | src/report.rs | function | format_line
callers | src/model.rs | function | entry | src/report.rs | function | renamed
callers | src/traits.rs | method | Ticks.now | src/report.rs | function | render
callers | src/traits.rs | method | Ticks.receipt | src/report.rs | function | render
callees | src/lib.rs | function | summarise | src/service.rs | function | describe
callees | src/service.rs | function | describe | src/service.rs | function | format_line
implementations | src/traits.rs | trait | Clock | src/traits.rs | struct | Ticks
implementations | src/traits.rs | trait | Saveable | src/traits.rs | struct | Meters

# ---------------------------------------------------------------------------
# Context quality: a target an agent would type, and the entity the pack has to
# contain for the answer to be any use.
# ---------------------------------------------------------------------------
context | summarise | src/lib.rs | function | summarise
context | Sink.push | src/report.rs | method | Sink.push
context | src/model.rs | src/model.rs | file | model.rs
context | MAX_ROWS | src/lib.rs | constant | MAX_ROWS
context | Runner.run | src/service.rs | method | Runner.run

# `format_line` is declared in two files. The surface must refuse the bare name
# and offer both candidates rather than silently pick one.
context_ambiguous | format_line

# ---------------------------------------------------------------------------
# Floors. Ratchets in hundredths of a percent, each set from the measurement this
# fixture produces. Raising one is a reviewable act belonging to the commit that
# improves the number.
# ---------------------------------------------------------------------------
floor | symbol_precision | 0
floor | symbol_recall | 0
floor | definitions | 0
floor | calls | 0
floor | references | 0
floor | imports | 0
floor | members | 0
floor | inheritance_subject | 0
floor | inheritance_base | 0
floor | negative_references | 0
floor | negative_inheritance | 0
floor | incremental | 100
floor | query | 0
floor | context | 0