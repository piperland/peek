# Normalise line endings in the repository.
* text=auto eol=lf

# Windows scripts must keep CRLF to remain executable by cmd/powershell.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary / generated assets.
*.png  binary
*.jpg  binary
*.svg  text eol=lf
*.wasm binary
*.sqlite binary
